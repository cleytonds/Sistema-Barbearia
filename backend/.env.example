PORT=3000
NODE_ENV=development
# Uma ou mais origens permitidas, separadas por vírgula.
FRONTEND_URL=http://localhost:5173
# Em producao, informe somente hops/CIDRs explicitos (ex.: loopback ou 10.0.0.0/8).
# Deixe vazio para conexao direta, sem proxy confiavel.
TRUST_PROXY=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=""
DB_NAME=barbearia_agendamento
DB_CONNECTION_LIMIT=10
# A aplicação armazena instantes em UTC; não altere a timezone da conexão.

JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=barbearia-api
JWT_AUDIENCE=barbearia-web
JWT_REVOCATION_CLEANUP_MINUTES=60

BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Elite Barbearia 081
